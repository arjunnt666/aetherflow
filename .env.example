# AetherFlow Environment Configuration

AETHERFLOW_ENV=development
AETHERFLOW_LOG_LEVEL=INFO
AETHERFLOW_API_HOST=0.0.0.0
AETHERFLOW_API_PORT=8080

# LLM Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
